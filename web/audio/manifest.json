    "welcome-0-say": {
      "url": "audio/welcome-0-say-f90b0eff4738b270.mp3",
      "text": "Welcome to Little Harbor! We are planning a welcome day for new visitors. Introduce yourself with an explorer name, and tell me something you enjoy.",
      "person": "lily",
      "voice": "af_heart",
      "speed": 0.94,
      "duration": 9.3,
      "bytes": 93884,
      "fingerprint": "f90b0eff4738b270",
