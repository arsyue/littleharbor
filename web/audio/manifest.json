      "voice": "af_heart",
      "speed": 0.94,
      "duration": 9.15,
      "bytes": 92444,
      "fingerprint": "0cfb67429d11cd82",
      "sha256": "ff10b19dee2698fd7cda500c42956b11560ce4bb20130db13322990100099a56"
