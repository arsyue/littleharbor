    },
    "welcome-0-hint": {
      "url": "audio/welcome-0-hint-058f0ac3b98061e9.mp3",
      "text": "My explorer name is Sunny, and I enjoy learning about animals.",
      "person": "lily",
      "voice": "af_heart",
      "speed": 0.94,
      "duration": 4.425,
      "bytes": 45164,
      "fingerprint": "058f0ac3b98061e9",
