    },
    "welcome-0-feedback": {
      "url": "audio/welcome-0-feedback-166012ff6f89594c.mp3",
      "text": "Lovely to meet you! Your interests will help us choose a good first stop.",
      "person": "lily",
      "voice": "af_heart",
      "speed": 0.94,
      "duration": 4.375,
      "bytes": 44684,
      "fingerprint": "166012ff6f89594c",
      "sha256": "1106b94cd99c112ad840a49587410f39b32693002fb99d3b5b0e2a0c04fec10c"
    },
    "welcome-1-say": {
      "url": "audio/welcome-1-say-a14372774d3f4fb7.mp3",
      "text": "We can start at the library or the fish market. Which place would you choose, and why? Give me a reason, not just the name.",
      "person": "lily",
      "voice": "af_heart",
      "speed": 0.94,
      "duration": 7.525,
      "bytes": 76124,
      "fingerprint": "a14372774d3f4fb7",
      "sha256": "39aea928c0d33de5f710c5c4753102d477ecfe2fceee16f875e04006e02dd5a8"
    },
    "welcome-1-hint": {
      "url": "audio/welcome-1-hint-c1b6517cf60ce4a5.mp3",
      "text": "I would choose the library because I enjoy reading animal stories.",
      "person": "lily",
      "voice": "af_heart",
      "speed": 0.94,
      "duration": 4.65,
      "bytes": 47324,
      "fingerprint": "c1b6517cf60ce4a5",
      "sha256": "963d0ba8ed4f3dc36d4c18519782cc89d24a62fa5c1361d845de20b776016275"
    },
    "welcome-1-feedback": {
      "url": "audio/welcome-1-feedback-867c4e1418cc8241.mp3",
      "text": "That sounds like a thoughtful choice. A reason helps other people understand your plan.",
      "person": "lily",
      "voice": "af_heart",
      "speed": 0.94,
      "duration": 5.65,
      "bytes": 57404,
      "fingerprint": "867c4e1418cc8241",
      "sha256": "6354911b3f3d4d2cfc37ce3660eadbf6841a23af74fcf92fc87ce2ddae0887ad"
    },
    "welcome-2-say": {
      "url": "audio/welcome-2-say-6455381d193c82fb.mp3",
      "text": "Please check the sign outside the library. When does it open, and when does it close? Tell me both times in one sentence.",
      "person": "lily",
      "voice": "af_heart",
      "speed": 0.94,
      "duration": 7.7,
      "bytes": 77804,
      "fingerprint": "6455381d193c82fb",
      "sha256": "cd61850883d69a7126c91eb2a4af87d89f68cf0809cb80d95f6d6ed566d13b1c"
    },
    "welcome-2-hint": {
      "url": "audio/welcome-2-hint-5cca6b6da7ff6bdb.mp3",
      "text": "The library opens at nine and closes at five.",
      "person": "lily",
      "voice": "af_heart",
      "speed": 0.94,
      "duration": 3.575,
      "bytes": 36524,
      "fingerprint": "5cca6b6da7ff6bdb",
      "sha256": "7ae6a67ca8e7f961f6cd822b6422a468008aaee15fb0e35f14f0eabdcbe702e0"
    },
    "welcome-2-feedback": {
      "url": "audio/welcome-2-feedback-436bb9d6549e9e94.mp3",
      "text": "Exactly. We can visit during the afternoon and still have plenty of time.",
      "person": "lily",
      "voice": "af_heart",
      "speed": 0.94,
      "duration": 5.0,
      "bytes": 50924,
      "fingerprint": "436bb9d6549e9e94",
      "sha256": "7e98281c2474044e9637de1c2e641d5db76398962b0204fc9c2d8036dc118016"
    },
    "welcome-3-say": {
      "url": "audio/welcome-3-say-0cfb67429d11cd82.mp3",
      "text": "A visitor is standing at the library and wants to reach the fish market. The fountain is between them. Give directions using past and then.",
